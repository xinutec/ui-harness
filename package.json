{
  "name": "@xinutec/ui-harness",
  "version": "0.1.0",
  "description": "The fleet's shared UI layer. This package is the web half: phone-width layout checks that render in a real browser at true device geometry and assert about painted pixels, not source. The shared Android WebView shell lives in the same repo under android/, consumed by Gradle rather than npm.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/ui-harness.d.ts",
      "default": "./dist/ui-harness.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./serve": {
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    }
  },
  "types": "./dist/ui-harness.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "test": "playwright test",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.61.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinutec/ui-harness.git"
  },
  "license": "UNLICENSED"
}
