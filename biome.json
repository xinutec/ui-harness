{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"formatter": { "enabled": false },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"nursery": {
				"noBaseToString": "error"
			}
		}
	},
	"files": {
		"includes": [
			"src/**/*.ts",
			"tests/**/*.ts",
			"scripts/**/*.ts",
			"*.config.ts"
		]
	}
}
