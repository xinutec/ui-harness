{
  "name": "@xinutec/ui-scaffold",
  "version": "0.1.0",
  "description": "The fleet's Angular app frame: the top bar, where up goes from each route, and sheets and dialogs the back gesture closes. An Angular library, built by ng-packagr, beside @xinutec/ui-harness in the same repo.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./types/xinutec-ui-scaffold.d.ts",
      "default": "./fesm2022/xinutec-ui-scaffold.mjs"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "types": "./dist/types/xinutec-ui-scaffold.d.ts",
  "sideEffects": false,
  "peerDependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/router": "^22.1.7",
    "rxjs": "~7.8.2"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinutec/ui-harness.git",
    "directory": "scaffold"
  },
  "license": "UNLICENSED",
  "module": "fesm2022/xinutec-ui-scaffold.mjs",
  "typings": "types/xinutec-ui-scaffold.d.ts"
}