{
  "name": "@xinutec/ui-scaffold",
  "version": "0.1.0",
  "description": "The fleet's Angular app frame: the top bar, where up goes from each route, and sheets and dialogs the back gesture closes. An Angular library, built by ng-packagr, beside @xinutec/ui-harness in the same repo.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/xinutec-ui-scaffold.d.ts",
      "default": "./dist/fesm2022/xinutec-ui-scaffold.mjs"
    }
  },
  "types": "./dist/types/xinutec-ui-scaffold.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "ng-packagr -p ng-package.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint:styles": "stylelint \"src/**/*.scss\""
  },
  "peerDependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/router": "^22.1.7",
    "rxjs": "~7.8.2"
  },
  "dependencies": {
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/material": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "ng-packagr": "^22.1.1",
    "rxjs": "~7.8.2",
    "stylelint": "^17.14.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinutec/ui-harness.git",
    "directory": "scaffold"
  },
  "license": "UNLICENSED"
}
